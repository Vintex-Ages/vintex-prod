{
  "components": {
    "front-end": {
      "paths": ["front-end/**"],
      "requires": "front-end/package.json"
    },
    "back-end": {
      "paths": [
        "back-end/app/**",
        "back-end/tests/**",
        "back-end/alembic/**",
        "back-end/alembic.ini",
        "back-end/requirements.txt",
        "back-end/Dockerfile",
        "back-end/pytest.ini",
        "back-end/docker-compose.yml"
      ],
      "requires": "back-end/requirements.txt"
    },
    "infra": {
      "paths": ["back-end/infra/**", "back-end/scripts/infra/**", "back-end/Makefile"],
      "requires": "back-end/Makefile"
    },
    "automation": {
      "paths": [".github/scripts/**", "config/**"]
    },
    "docs": {
      "paths": ["documentation/**"]
    }
  },
  "runAllWhenChanged": [".github/workflows/**", ".github/config/**"],
  "allModeEvents": ["push", "schedule", "workflow_dispatch"],
  "allModeBaseRefs": ["qa", "main", "deploy"]
}
