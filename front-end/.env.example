# URL base da API do back-end (repositório separado). Termina em `/api` de
# propósito: é o `baseURL` do `httpClient`, e por isso os caminhos nos services
# começam depois dele (`/users/me/store`, e não `/api/users/me/store`).
# A porta é a do `APP_PORT` do back, 8000. Estava 3000 aqui, que é porta onde
# nada escuta — e com o mock ligado por padrão ninguém percebia.
VITE_API_BASE_URL=http://localhost:8000/api

# Liga o mock em memória/local dos services (authService, catalogService,
# preferenceService etc.); "false" chama a API real via httpClient.
VITE_USE_MOCKS=true
