# URL base da API do back-end (repositório separado)
VITE_API_BASE_URL=http://localhost:8000/api

# Liga o mock em memória/local dos services (authService, catalogService,
# preferenceService etc.); "false" chama a API real via httpClient.
VITE_USE_MOCKS=true

# Overrides opcionais. Quando ausentes, herdam VITE_USE_MOCKS.
# Descomente ambos para usar somente feed e estilos da API real.
# VITE_USE_MOCKS_FEED=false
# VITE_USE_MOCKS_STYLES=false
